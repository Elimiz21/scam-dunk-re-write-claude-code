# Database (PostgreSQL/Supabase)
# DATABASE_URL: in serverless this MUST be the POOLED connection (Supabase
#   pgBouncer on :6543) with an explicit connection_limit, e.g.:
#   postgresql://user:password@db.xxx.supabase.co:6543/postgres?pgbouncer=true&connection_limit=1
#   Using the direct :5432 host here exhausts Postgres connections under load.
# DIRECT_URL: the UNPOOLED host (:5432), used only by `prisma migrate`.
DATABASE_URL="postgresql://user:password@host:6543/database?pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://user:password@host:5432/database"

# NextAuth
# Generate secret with: openssl rand -base64 32
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-nextauth-secret-generate-with-openssl-rand-base64-32"

# Email (Resend)
# Get API key from: https://resend.com/api-keys
RESEND_API_KEY="re_your-resend-api-key"
EMAIL_FROM="ScamDunk <noreply@yourdomain.com>"
# Admin email for system alerts (API failures, etc.)
ADMIN_ALERT_EMAIL="admin@yourdomain.com"
# Inbound email webhook secret (for receiving emails at support@scamdunk.com)
# Generate with: openssl rand -hex 32
INBOUND_EMAIL_WEBHOOK_SECRET="your-inbound-webhook-secret"

# Cloudflare Turnstile (CAPTCHA)
# Get keys from: https://dash.cloudflare.com/?to=/:account/turnstile
NEXT_PUBLIC_TURNSTILE_SITE_KEY="your-turnstile-site-key"
TURNSTILE_SECRET_KEY="your-turnstile-secret-key"

# OpenAI (for narrative generation)
# Get API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY="sk-your-openai-api-key"

# Financial Modeling Prep (PRIMARY - for real market data)
# Get API key from: https://site.financialmodelingprep.com/developer/docs
# Starter plan ($29/mo): 300 requests/min, 5 years historical data
FMP_API_KEY="your-fmp-api-key"

# Alpha Vantage (LEGACY - kept for backward compatibility)
# Get free API key from: https://www.alphavantage.co/support/#api-key
ALPHA_VANTAGE_API_KEY="your-alpha-vantage-api-key"

# OTC Markets (optional - free public API used by default)
# Only needed if you have a paid OTC Markets API subscription
# Free tier uses backend.otcmarkets.com public endpoints for Caveat Emptor, tier, shell risk
OTC_MARKETS_API_KEY=""

# FINRA BrokerCheck (optional - free public API used by default)
# Only needed if you have an official FINRA API Developer Center subscription
# Free tier uses api.brokercheck.finra.org for firm/individual disclosures
FINRA_API_KEY=""

# Python AI Backend (for full ML models: Random Forest, LSTM, Anomaly Detection)
# Deploy the python_ai module and set the URL here
# Local development: http://localhost:8000
# Production: Your deployed Python API URL
AI_BACKEND_URL="http://localhost:8000"
# Shared secret between Next.js and Python AI backend (required in production)
# Must match on both sides. Generate with: openssl rand -hex 32
AI_API_SECRET=""

# PayPal Billing (the app's payment provider — no Stripe code exists)
# Create an app at https://developer.paypal.com/dashboard/applications
# PAYPAL_MODE: "sandbox" or "live"
PAYPAL_CLIENT_ID=""
PAYPAL_CLIENT_SECRET=""
PAYPAL_MODE="sandbox"
# Subscription plan id (P-...) created in the PayPal dashboard
PAYPAL_PLAN_ID=""
# Webhook id used to verify webhook signatures (required for billing webhooks)
PAYPAL_WEBHOOK_ID=""

# Mobile app auth (iOS): JWT signing secrets for /api/auth/mobile/*
# Generate each with: openssl rand -hex 32
JWT_SECRET=""
JWT_REFRESH_SECRET=""

# Plan Limits (configurable)
FREE_CHECKS_PER_MONTH="5"
PAID_CHECKS_PER_MONTH="200"

# ===== OPERATIONAL SECRETS (all required in production) =====
# Vercel Cron auth for /api/cron/ingest-evaluation. Vercel automatically sends
# it as `Authorization: Bearer $CRON_SECRET` on scheduled invocations; the
# route refuses to run without it. Generate: openssl rand -hex 32
CRON_SECRET=""
# One-time admin bootstrap key for /api/admin/init and /api/admin/setup
ADMIN_SETUP_KEY=""
# Bearer key the daily pipeline uses to call POST /api/admin/social-scan
SOCIAL_SCAN_API_KEY=""
# Bearer key for POST /api/admin/social-scan/ingest (out-of-band result upload)
SOCIAL_SCAN_INGEST_KEY=""
# Optional: set to "false" to disable the deterministic no-downgrade guard on
# AI-backend results (defaults to enabled)
AI_NO_DOWNGRADE_GUARD=""

# Rate limiting & admin-aggregate caching (Upstash Redis, OPTIONAL)
# When both are set, rate limiting and the admin aggregate cache use a single
# shared store across all serverless instances (recommended for production).
# When unset, rate limiting falls back to PostgreSQL (via Prisma) and the cache
# falls back to a per-instance in-memory store — the app works either way.
# Create a database at https://console.upstash.com/ and copy the REST creds.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Sentry (for error monitoring)
# Get DSN from: https://sentry.io/
NEXT_PUBLIC_SENTRY_DSN="https://xxx@xxx.ingest.sentry.io/xxx"
SENTRY_ORG="your-sentry-org"
SENTRY_PROJECT="your-sentry-project"

# Supabase (optional - for direct access)
NEXT_PUBLIC_SUPABASE_URL="https://xxx.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJ..."

# Market intelligence data source repo (owner/name on GitHub)
# Default: Elimiz21/scam-dunk-data
SCAN_DATA_REPO="Elimiz21/scam-dunk-data"

# GitHub token for reading the scan-data repo (OPTIONAL but recommended).
# Without it, the admin intelligence pages share the unauthenticated GitHub
# limit of 60 req/h/IP and can go dark mid-session; a token raises it to
# 5,000/h. A fine-grained/classic token with read-only access to the data repo
# (public repo: no scopes needed) is sufficient.
GITHUB_TOKEN=""

# Browser Agent Platform Credentials (for browser-based social scanning)
# These are your PERSONAL account credentials used by browser agents.
# 2FA secrets are optional but recommended for accounts with 2FA enabled.
BROWSER_DISCORD_EMAIL=""
BROWSER_DISCORD_PASSWORD=""
BROWSER_DISCORD_2FA_SECRET=""
BROWSER_REDDIT_USERNAME=""
BROWSER_REDDIT_PASSWORD=""
BROWSER_REDDIT_2FA_SECRET=""
BROWSER_TWITTER_USERNAME=""
BROWSER_TWITTER_PASSWORD=""
BROWSER_TWITTER_2FA_SECRET=""
BROWSER_INSTAGRAM_USERNAME=""
BROWSER_INSTAGRAM_PASSWORD=""
BROWSER_INSTAGRAM_2FA_SECRET=""
BROWSER_FACEBOOK_EMAIL=""
BROWSER_FACEBOOK_PASSWORD=""
BROWSER_FACEBOOK_2FA_SECRET=""
BROWSER_TIKTOK_USERNAME=""
BROWSER_TIKTOK_PASSWORD=""
BROWSER_TIKTOK_2FA_SECRET=""
# AES-256 encryption key for browser session/cookie storage
# Generate with: openssl rand -hex 32
BROWSER_SESSION_ENCRYPTION_KEY=""

# ===== SOCIAL SCAN API KEYS =====
# These power the social media promotion scanner (Admin > Social Scan > Run Scan)
# Reddit and StockTwits scanners work without keys.
# Add these for broader coverage:

# YouTube Data API v3 (search for stock promo videos)
# Get API key from: https://console.cloud.google.com/apis/credentials
# Enable "YouTube Data API v3" in your GCP project
# Free tier: 10,000 units/day (1 search = 100 units = ~100 searches/day)
YOUTUBE_API_KEY=""

# Serper.dev (Google Search Alternative for social media sweep)
# Get API key from: https://serper.dev/
# Free: 2,500 queries initially
SERPER_API_KEY=""

# Perplexity AI (web-grounded social media research)
# Get API key from: https://www.perplexity.ai/settings/api
# Pricing: ~$1/1,000 searches with sonar model
PERPLEXITY_API_KEY=""

# Anthropic Claude (AI analysis)
# Get API key from: https://console.anthropic.com/
ANTHROPIC_API_KEY=""

# Discord Bot (search joined servers for ticker mentions)
# Create app at: https://discord.com/developers/applications
# Enable MESSAGE_CONTENT intent, invite bot to target servers
DISCORD_BOT_TOKEN=""

# Browser Agent Config
BROWSER_AGENT_ENABLED="false"
BROWSER_AGENT_DISCORD_ENABLED="false"
BROWSER_AGENT_REDDIT_ENABLED="false"
BROWSER_AGENT_TWITTER_ENABLED="false"
BROWSER_AGENT_INSTAGRAM_ENABLED="false"
BROWSER_AGENT_FACEBOOK_ENABLED="false"
BROWSER_AGENT_TIKTOK_ENABLED="false"
BROWSER_AGENT_MAX_PARALLEL="2"
BROWSER_AGENT_MAX_DAILY_MINUTES="60"
BROWSER_AGENT_MAX_MEMORY_MB="2048"
# Generate with: openssl rand -hex 32
BROWSER_AGENT_ENCRYPTION_KEY=""

# Preview Admin Access (Vercel PREVIEW deployments only)
# The real gate is VERCEL_ENV === "preview" plus this password — there is no
# PREVIEW_ADMIN_ENABLED flag in the code. Leave unset in production; the
# preview-login route refuses to run outside preview regardless.
PREVIEW_ADMIN_PASSWORD=""
